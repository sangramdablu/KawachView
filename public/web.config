<?xml version="1.0" encoding="UTF-8"?>
<!--
  IMPORTANT: If your production server already has a web.config in the
  public/ folder (likely, since pretty URLs work there — IIS URL Rewrite
  always stores its rules in a web.config), do NOT overwrite it with this
  file. Merge only the <staticContent> block below into your existing
  production web.config instead, to avoid losing your URL Rewrite rules.

  This block exists because IIS does not register the video/mp4 (and
  sometimes video/webm) MIME type by default on every Windows Server
  install. Without it, IIS returns an HTTP 404.3 error for any .mp4 file
  request even though the file exists on disk and has correct permissions
  — the exact symptom of a video that "should" work but silently doesn't
  play. <remove> before each <add> is required: if the MIME type already
  exists at the server level, an <add> alone causes an IIS 500.19
  "Cannot add duplicate collection entry" config error.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".webm" />
      <mimeMap fileExtension=".webm" mimeType="video/webm" />
    </staticContent>
  </system.webServer>
</configuration>
